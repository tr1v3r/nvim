{
	"name": "snips",
	"engines": {
		"vscode": "^1.11.0"
	},
	"contributes": {
		"snippets": [
			{
				"language": "go",
				"path": "./snippets/go.json"
			},
			{
				"language": "markdown",
				"path": "./snippets/markdown.json"
			},
			{
				"language": "python",
				"path": "./snippets/python.json"
			},
			{
				"language": "rust",
				"path": "./snippets/rust.json"
			},
			{
				"language": [
					"plaintex",
					"tex"
				],
				"path": "./snippets/tex.json"
			}
		]
	}
}
